{
    "name": "fuzzphony/fuzzphony",
    "description": "Fuzzy search, in perfect harmony with your database. PostgreSQL-native full-text + trigram search for PHP and Symfony, without an extra service.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "search",
        "full-text",
        "fuzzy",
        "postgresql",
        "pg_trgm",
        "symfony",
        "doctrine"
    ],
    "homepage": "https://github.com/er2es/fuzzphony",
    "authors": [
        {
            "name": "Szabó József",
            "homepage": "https://github.com/er2es"
        }
    ],
    "support": {
        "issues": "https://github.com/er2es/fuzzphony/issues",
        "source": "https://github.com/er2es/fuzzphony",
        "security": "https://github.com/er2es/fuzzphony/security/advisories/new"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "suggest": {
        "doctrine/dbal": "Use an existing Doctrine DBAL connection (Fuzzphony\\Bridge\\Doctrine\\DbalConnection)",
        "doctrine/orm": "Load results as entities (EntityLoader) and sync in ORM mode (OrmSyncListener)",
        "symfony/framework-bundle": "Symfony integration: configuration, autowiring and the fuzzphony:* console commands",
        "symfony/messenger": "Asynchronous refresh in ORM sync mode (fuzzphony.orm_sync.async)",
        "symfony/ux-live-component": "The <twig:Fuzzphony:Search> search-as-you-type component",
        "api-platform/doctrine-orm": "FuzzphonySearchFilter for API Platform collections"
    },
    "conflict": {
        "doctrine/dbal": "<4.2",
        "doctrine/orm": "<3.3",
        "symfony/framework-bundle": "<7.4"
    },
    "require-dev": {
        "api-platform/doctrine-orm": "^4.1 || ^5.0",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/ux-live-component": "^2.22 || ^3.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "symplify/monorepo-builder": "^11.2 || ^12.0"
    },
    "replace": {
        "fuzzphony/core": "self.version",
        "fuzzphony/postgres-engine": "self.version",
        "fuzzphony/doctrine-bridge": "self.version",
        "fuzzphony/symfony-bundle": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Fuzzphony\\Core\\": "src/Core/",
            "Fuzzphony\\Engine\\Postgres\\": "src/Engine/Postgres/",
            "Fuzzphony\\Bridge\\Doctrine\\": "src/Bridge/Doctrine/",
            "Fuzzphony\\Bundle\\": "src/Bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fuzzphony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:all": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
