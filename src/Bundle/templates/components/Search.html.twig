{# Highlights are HTML-escaped by Fuzzphony (only <mark> is added), so |raw is safe here. #}
<div {{ attributes.defaults({class: 'fuzzphony-search'}) }}>
    <input type="search"
           data-model="debounce(200)|query"
           value="{{ query }}"
           placeholder="{{ placeholder }}"
           autocomplete="off"
           aria-label="{{ placeholder }}"
           class="fuzzphony-search__input">

    {# The word being typed, completed from the index's vocabulary. The completions are plain text: Twig escapes them. #}
    {% set completions = this.completions %}
    {% if completions %}
        <ul class="fuzzphony-search__completions" aria-label="Suggestions">
            {% for completion in completions %}
                <li><button type="button" data-action="live#action" data-live-action-param="useCompletion" data-live-text-param="{{ completion }}">{{ completion }}</button></li>
            {% endfor %}
        </ul>
    {% endif %}

    {% set result = this.result %}
    {% if result %}
        <p class="fuzzphony-search__meta" aria-live="polite">
            {{ result.total }}{{ result.totalIsLowerBound ? '+' }} result{{ result.total == 1 ? '' : 's' }}
            · {{ result.tookMs|number_format(1) }} ms
            {% if result.usedFuzzy %}· typo tolerant{% endif %}
        </p>
        {% for warning in result.warnings %}
            <p class="fuzzphony-search__warning">{{ warning }}</p>
        {% endfor %}
        {% if result.didYouMean %}
            <p class="fuzzphony-search__did-you-mean">Did you mean
                <button type="button" data-action="live#action" data-live-action-param="useSuggestion">{{ result.didYouMean }}</button>?</p>
        {% endif %}
        {# Facets: the values of a filter with their counts; choosing one narrows the search, choosing it again lifts it. #}
        {% for name, values in result.facets %}
            {% if values %}
                <div class="fuzzphony-search__facet" data-facet="{{ name }}">
                    <span class="fuzzphony-search__facet-name">{{ name }}</span>
                    {% for facet in values %}
                        {% set value = facet.value is null ? '' : (facet.value is same as(true) ? '1' : (facet.value is same as(false) ? '0' : facet.value)) %}
                        {% set chosen = selected[name] is defined and selected[name] == value %}
                        <button type="button" aria-pressed="{{ chosen ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="toggleFacet" data-live-filter-param="{{ name }}" data-live-value-param="{{ value }}">
                            {{ facet.value is null ? '(none)' : (facet.value is same as(true) ? 'yes' : (facet.value is same as(false) ? 'no' : facet.value)) }}
                            <span class="fuzzphony-search__facet-count">{{ facet.count }}{{ result.totalIsLowerBound ? '+' }}</span>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}
        <ol class="fuzzphony-search__hits">
            {% for hit in result.hits %}
                <li class="fuzzphony-search__hit" data-id="{{ hit.id }}">
                    {% block hit %}
                        {% for field, snippet in hit.highlights %}
                            <span class="fuzzphony-search__{{ field }}">{{ snippet|raw }}</span>
                        {% else %}
                            #{{ hit.id }}
                        {% endfor %}
                    {% endblock %}
                </li>
            {% else %}
                <li class="fuzzphony-search__empty">No results.</li>
            {% endfor %}
        </ol>
    {% endif %}
</div>
