{
    "name": "fuzzphony/demo",
    "description": "Fuzzphony demo: with/without comparison, ranking playground, config wizard, benchmark.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.3",
        "fuzzphony/fuzzphony": "*@dev",
        "symfony/asset-mapper": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/stimulus-bundle": "^3.5",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-live-component": "^3.5",
        "symfony/ux-twig-component": "^3.5",
        "symfony/yaml": "^8.1"
    },
    "repositories": [
        { "type": "path", "url": "..", "options": { "symlink": true } }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": { "psr-4": { "App\\": "src/" } },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    },
    "scripts": {
        "setup": [
            "@php bin/console fuzzphony:schema --apply",
            "@php bin/console fuzzphony:reindex --batch=20000",
            "@php bin/console fuzzphony:doctor"
        ]
    }
}
