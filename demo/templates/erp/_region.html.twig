{# The results of a section, swapped in place while the visitor types (live_search_controller.js). Rows come from Hit::$data, the lines from Hit::$matches. #}
{% import '_ui.html.twig' as ui %}

{% macro row(hit, q, strict, city) %}
    {% import '_ui.html.twig' as ui %}
    {% set d = erp_row(hit) %}
    {% set title %}<a href="{{ path('erp_detail', {kind: hit.kind, id: hit.id}) }}">{{ d.title }}</a>{% endset %}
    {% set aside %}<div class="row-flags"><span class="flag" title="index">{{ hit.index }}</span>{% if hit.index == 'site' or hit.kind != hit.index %}<span class="flag is-ok" title="kind">{{ hit.kind }}</span>{% endif %}</div>{% endset %}
    {% set below %}{% for l in erp_lines(hit) %}<div class="row-match"><span class="match-label">{{ l.label }}</span> {{ l.html|raw }}</div>{% endfor %}{% set why = erp_reasons(hit, q, strict, city) %}{% if why %}<div class="row-why"><span class="why-label">Why:</span> {{ why|join(' · ') }}</div>{% endif %}{% endset %}
    {{ ui.product_row('', title, d.sub, aside, null, below) }}
{% endmacro %}
{% import _self as r %}

{% if error %}
    <p class="callout is-bad" role="alert">{{ error }}</p>
{% elseif q != '' and tab != 'combined' %}
    <p hidden data-status>{{ result.total }} {{ result.total == 1 ? 'result' : 'results' }} for {{ q }}.</p>
    <section class="results" aria-label="Results">
        <div class="results-head">
            <div class="stat">
                <span class="stat-value">{{ result.tookMs < 10 ? result.tookMs|number_format(1) : result.tookMs|number_format(0) }}</span><span class="stat-unit">ms</span>
                <span class="stat-caption">{{ result.total|number_format }}{{ result.totalIsLowerBound ? '+' }} {{ result.total == 1 ? 'hit' : 'hits' }}{% if result.usedFuzzy %} · typo tolerant{% endif %}</span>
            </div>
        </div>
        {# The filters in force, as tokens: each lifts only itself (a link built from the whole state of the page), "Clear all" lifts them all. #}
        {% set chosen = [] %}
        {% if filters.city != '' %}{% set chosen = chosen|merge([{key: 'city', label: 'City: ' ~ filters.city}]) %}{% endif %}
        {% if filters.status != '' %}{% set chosen = chosen|merge([{key: 'status', label: 'Status: ' ~ filters.status}]) %}{% endif %}
        {% if filters.created != '' %}{% set chosen = chosen|merge([{key: 'created', label: created_options[filters.created][0]}]) %}{% endif %}
        {% if filters.total != '' %}{% set chosen = chosen|merge([{key: 'total', label: 'Total: ' ~ total_options[filters.total][0]}]) %}{% endif %}
        {% if chosen %}
            <div class="chips" aria-label="Chosen filters">
                {% for c in chosen %}
                    <a class="token" href="{{ path('erp', state|merge({(c.key): ''})|filter(v => v != '')) }}" aria-label="Remove the filter {{ c.label }}">{{ c.label }}<svg class="icon" aria-hidden="true"><use href="#i-clear"/></svg></a>
                {% endfor %}
                {% if chosen|length > 1 %}<a class="token token-clear" href="{{ path('erp', state|merge({city: '', status: '', created: '', total: ''})|filter(v => v != '')) }}">Clear all</a>{% endif %}
            </div>
        {% endif %}
        {% if tab == 'people' %}
            <p class="erp-why" data-address-note>
                {% if single %}What this shows: <code>manyMatch('single')</code> keeps only the people with one address that holds every word; people whose words are spread over two addresses drop out.
                    {% if filters.city != '' %}The city facet is coupled to the same address (<code>same_row_as: address</code>): <strong>{{ filters.city }}</strong> must be the city of the address that holds the words, and the counts on the left are exact. Try <code>fő utca</code> with Szeged: Gábor Orosz has <em>Fő utca 85</em> in Győr and a Szeged address on another street, so he is among the 490 people of the default mode but not among the 294 here (with <code>fő utca szeged</code> the facet then lists Szeged alone, 294, where the default mode adds the 196 people whose Fő utca is in another city).{% else %}Choose a city on the left: it must then be the city of that very address (<code>same_row_as: address</code>), and the counts are exact. Try <code>fő utca</code> with Szeged: Gábor Orosz has <em>Fő utca 85</em> in Győr and a Szeged address on another street, so only the default mode (490 people against 294) finds him.{% endif %}
                {% elseif best %}What this shows: <code>rank: best</code> ranks a person by their best single address, so one address with every word comes before words spread over two addresses. The same people are found.
                {% else %}What this shows: with the default ranking all addresses of a person count as one text, so words spread over two addresses rank like words in one.{% endif %}
            </p>
        {% endif %}
        {% if result.warnings %}<div class="warnings">{% for w in result.warnings %}<p>{{ w }}</p>{% endfor %}</div>{% endif %}
        {% if not hits %}
            <div class="empty"><strong>Nothing found for “{{ q }}”</strong>Check the spelling or lift a filter.</div>
        {% else %}
            <div class="results-layout{{ facets ? '' : ' no-side' }}">
                {% if facets %}
                    <aside class="facets-side" aria-label="Narrow the results">
                        <div>
                            <h2 class="facet-title">{{ tab == 'people' ? 'City of an address' : 'Status' }}</h2>
                            <div class="facet">
                                {% for f in facets %}
                                    {% set on = (tab == 'people' ? filters.city : filters.status) == f.value %}
                                    <a href="{{ path('erp', state|merge({(tab == 'people' ? 'city' : 'status'): on ? '' : f.value})|filter(v => v != '')) }}"{% if on %} aria-current="true"{% endif %}><span>{{ f.value }}</span><span>{{ f.count|number_format }}{{ result.totalIsLowerBound ? '+' }}</span></a>
                                {% endfor %}
                            </div>
                        </div>
                    </aside>
                {% endif %}
                <ul class="list" aria-label="Results">
                    {% for hit in hits %}{{ r.row(hit, q, single|default(false), filters.city|default("")) }}{% endfor %}
                </ul>
            </div>
        {% endif %}
    </section>
{% elseif q != '' and tab == 'combined' %}
    {% set both = mode == 'both' %}
    <p hidden data-status>{% if site %}{{ site.total }} in the multi-source index. {% endif %}{% if federated %}{{ federated.total }} in the federated search.{% endif %}</p>
    <div class="{{ both ? 'two-up is-aligned' : 'stack' }}">
        {% if site %}
            <section aria-labelledby="site-h">
                <h2 id="site-h" class="list-title">One multi-source index <code>site</code> · {{ site.total }}{{ site.totalIsLowerBound ? '+' }} hits · {{ site.tookMs|number_format(1) }} ms</h2>
                <div class="panel-tools">
                <div class="chips kind-chips" role="group" aria-label="Limit to a kind">
                    <a class="chip{{ kind == '' ? ' is-current' }}" href="{{ path('erp', state|merge({kind: ''})|filter(v => v != '')) }}"{% if kind == '' %} aria-current="true"{% endif %}>All</a>
                    {% for key, k in siteKinds %}<a class="chip{{ kind == key ? ' is-current' }}" href="{{ path('erp', state|merge({kind: key})|filter(v => v != '')) }}"{% if kind == key %} aria-current="true"{% endif %}>{{ k[1] }}</a>{% endfor %}
                </div>
                {% if kind != '' and siteKinds[kind] is defined %}<p class="erp-why">What this shows: <code>kinds('{{ siteKinds[kind][0] }}')</code> limits the one index to a single source: the hits and the total count only {{ siteKinds[kind][1]|lower }}.</p>
                {% else %}<p class="erp-why">What this shows: with no kind chosen the one index ranks people, companies and orders together; <code>kinds('order')</code> would limit it to a single source.</p>{% endif %}
                </div>
                {% if site.hits %}
                    <ul class="list" aria-label="Multi-source index results">{% for hit in site.hits %}{{ r.row(hit, q, false, "") }}{% endfor %}</ul>
                {% else %}
                    <div class="empty"><strong>Nothing found</strong></div>
                {% endif %}
            </section>
        {% endif %}
        {% if federated %}
            <section aria-labelledby="fed-h">
                <h2 id="fed-h" class="list-title">Federated over people, companies and orders · {{ federated.total }}{{ federated.totalIsLowerBound ? '+' }} hits · {{ federated.tookMs|number_format(1) }} ms</h2>
                <div class="panel-tools"><p class="erp-why">What this shows: a federated search runs one search per index (<code>people</code>, <code>companies</code>, <code>orders</code>) and merges the hits by rank, so <code>kinds()</code> does not apply to it.</p></div>
                {% if federated.hits %}
                    <ul class="list" aria-label="Federated search results">{% for hit in federated.hits %}{{ r.row(hit, q, false, "") }}{% endfor %}</ul>
                {% else %}
                    <div class="empty"><strong>Nothing found</strong></div>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endif %}
