{% extends 'base.html.twig' %}

{% block body %}
    <form method="get" class="searchbar" data-loading-message="Searching with Fuzzphony (1 cold + {{ warmRuns }} warm runs)…" data-controller="suggest" data-suggest-url-value="{{ path('suggest') }}" data-suggest-index-value="catalog" data-suggest-rich-value="true" data-suggest-page-value="{{ path('compare') }}">
        <input type="search" name="q" value="{{ q }}" aria-label="Search the catalogue" placeholder="Search the catalogue…" autofocus data-suggest-target="input" data-action="input->suggest#update" autocomplete="off">
        <button type="submit" class="primary">Search</button>
    </form>
    <p class="muted">
        Searching {{ rowEstimate > 0 ? rowEstimate|number_format ~ ' products' : 'the product catalogue' }} (<code>{{ table }}</code>):
        each search runs 1 cold + {{ warmRuns }} warm runs on both engines = {{ ((1 + warmRuns) * engines)|number_format }} statements.
        Fuzzphony renders below at once; ILIKE is much slower on this catalogue, so its column loads separately.
    </p>
    <div class="examples">
        {% for label, example in examples %}
            <a class="button" href="{{ path('compare', {q: example}) }}" data-loading-message="Searching for {{ example }}…">{{ label }}: <code>{{ example }}</code></a>
        {% endfor %}
    </div>

    {% if with %}
        <div class="grid">
            {# ILIKE is much slower than Fuzzphony on this catalogue (see the controller); rather than block the
               whole page on it, the column starts as a placeholder and ilike_controller.js fetches the real
               content from compare_ilike and swaps it in. A new search is a plain page navigation, so it never
               races this fetch; the controller's own AbortController only guards disconnects within a page. #}
            <section class="card" data-controller="ilike" data-src="{{ path('compare_ilike', {q: q}) }}">
                <div data-ilike-target="region" aria-busy="true">
                    <h2>With ILIKE <code>'%…%'</code></h2>
                    <p class="muted">ILIKE is scanning {{ rowEstimate > 0 ? rowEstimate|number_format ~ ' rows' : 'the catalogue' }}…</p>
                    <ul class="hits" aria-hidden="true">
                        <li><span class="skeleton"></span></li>
                        <li><span class="skeleton"></span></li>
                        <li><span class="skeleton"></span></li>
                    </ul>
                </div>
                <noscript><p class="muted"><a href="{{ path('compare_ilike', {q: q}) }}">Load the ILIKE results</a> (needs JavaScript to load on its own).</p></noscript>
            </section>
            <section class="card">
                {% set result = with.value %}
                <h2>With Fuzzphony</h2>
                <p class="muted">
                    {{ result.total }}{{ result.totalIsLowerBound ? '+' }} hits · warm median {{ with.warm|number_format(1) }} ms · cold {{ with.cold|number_format(1) }} ms
                    {% if result.usedFuzzy %}· typo tolerant{% endif %} · understood as <code>{{ result.interpretedAs }}</code>
                </p>
                {% for warning in result.warnings %}<p class="s-warning">{{ warning }}</p>{% endfor %}
                {% if result.didYouMean %}<p>Did you mean <a href="{{ path('compare', {q: result.didYouMean}) }}" data-loading-message="Searching for {{ result.didYouMean }}…"><strong>{{ result.didYouMean }}</strong></a>?</p>{% endif %}
                {# Facets: what is in the result, counted by value. A chosen value narrows the search; each facet still lists the other values of its own filter. #}
                {% if facets and (facets.categories or facets.stock) %}
                    <div class="facets" aria-label="Narrow the search">
                        <span class="muted">Category{% if facets.lowerBound %} (of the candidates){% endif %}:</span>
                        {% for c in facets.categories %}
                            {% set chosen = c.name == category %}
                            <a class="chip{{ chosen ? ' is-active' }}" href="{{ path('compare', {q: q, cat: chosen ? null : c.name, stock: stock is null ? null : (stock ? 1 : 0)}) }}"{% if chosen %} aria-current="true"{% endif %} data-loading-message="Searching…">{{ c.name }} <span class="muted">{{ c.count }}{{ facets.lowerBound ? '+' }}</span></a>
                        {% endfor %}
                        <span class="muted">Stock:</span>
                        {% for s in facets.stock %}
                            {% set chosen = stock is not null and stock == s.value %}
                            <a class="chip{{ chosen ? ' is-active' }}" href="{{ path('compare', {q: q, cat: category ?: null, stock: chosen ? null : (s.value ? 1 : 0)}) }}"{% if chosen %} aria-current="true"{% endif %} data-loading-message="Searching…">{{ s.value ? 'in stock' : 'out of stock' }} <span class="muted">{{ s.count }}{{ facets.lowerBound ? '+' }}</span></a>
                        {% endfor %}
                        <span class="muted">counted in {{ facets.tookMs|number_format(1) }} ms, not part of the timing above; ILIKE has no facets</span>
                    </div>
                {% endif %}
                <ul class="hits">
                    {% for hit in result.hits %}
                        {% set row = with.rows[hit.id] ?? null %}
                        <li>
                            {% if hit.highlights.name is defined %}{{ hit.highlights.name|raw }}{% else %}{{ row.name ?? hit.id }}{% endif %}
                            <span class="muted">· {{ row.brand ?? '' }} · score {{ hit.score|number_format(3) }}</span>
                        </li>
                    {% else %}
                        <li class="muted">Nothing found.</li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    {% else %}
        <p class="muted">Type something, or pick an example: the same catalogue, searched with a naive <code>ILIKE</code> and with Fuzzphony.</p>
    {% endif %}
{% endblock %}
