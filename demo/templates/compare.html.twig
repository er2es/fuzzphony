{% extends 'base.html.twig' %}

{% block body %}
    <form method="get">
        <input type="search" name="q" value="{{ q }}" placeholder="Search the catalogue…" autofocus>
    </form>
    <div class="examples">
        {% for label, example in examples %}
            <a class="button" href="{{ path('compare', {q: example}) }}">{{ label }}: <code>{{ example }}</code></a>
        {% endfor %}
    </div>

    {% if with %}
        <div class="grid">
            <section class="card">
                <h2>With ILIKE <code>'%…%'</code></h2>
                <p class="muted">{{ without.value|length }} hits · warm median {{ without.warm|number_format(1) }} ms · cold {{ without.cold|number_format(1) }} ms · no ranking</p>
                <ul class="hits">
                    {% for row in without.value %}
                        <li>{{ row.name }} <span class="muted">· {{ row.brand }}</span></li>
                    {% else %}
                        <li class="muted">Nothing found. The text has to match the stored spelling exactly.</li>
                    {% endfor %}
                </ul>
            </section>
            <section class="card">
                {% set result = with.value %}
                <h2>With Fuzzphony</h2>
                <p class="muted">
                    {{ result.total }}{{ result.totalIsLowerBound ? '+' }} hits · warm median {{ with.warm|number_format(1) }} ms · cold {{ with.cold|number_format(1) }} ms
                    {% if result.usedFuzzy %}· typo tolerant{% endif %} · understood as <code>{{ result.interpretedAs }}</code>
                </p>
                {% for warning in result.warnings %}<p class="s-warning">{{ warning }}</p>{% endfor %}
                <ul class="hits">
                    {% for hit in result.hits %}
                        {% set row = with.rows[hit.id] ?? null %}
                        <li>
                            {{ (hit.highlights.name ?? row.name ?? hit.id)|raw }}
                            <span class="muted">· {{ row.brand ?? '' }} · score {{ hit.score|number_format(3) }}</span>
                        </li>
                    {% else %}
                        <li class="muted">Nothing found.</li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    {% else %}
        <p class="muted">Type something, or pick an example: the same catalogue, searched with a naive <code>ILIKE</code> and with Fuzzphony, timed as median of 5 warm runs (the first, cold run is shown separately).</p>
    {% endif %}
{% endblock %}
