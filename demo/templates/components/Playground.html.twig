{# The slider readout updates instantly (range controller); the server is asked once the handle rests for 300 ms. #}
{% macro slider(label, model, value, min, max, step) %}
    <label class="slider" data-controller="range">
        <span class="slider-head">{{ label }} <output data-range-target="output" data-live-ignore aria-live="off">{{ value }}</output></span>
        <input type="range" data-action="input->range#update" data-model="debounce(300)|{{ model }}" value="{{ value }}" min="{{ min }}" max="{{ max }}" step="{{ step }}">
    </label>
{% endmacro %}
{% import _self as ui %}

<div {{ attributes.defaults(stimulus_controller('suggest', {url: path('suggest'), index: 'catalog', page: path('tune'), param: 'query', categories: false})) }} class="layout">
    <aside class="settings" aria-label="Settings">
        <section>
            <h2 class="list-title">Ranking</h2>
            <div class="list">
                {{ ui.slider('Full-text weight', 'text', text, 0, 2, 0.05) }}
                {{ ui.slider('Fuzzy weight', 'fuzzy', fuzzy, 0, 2, 0.05) }}
                {{ ui.slider('Exact title bonus', 'exactBonus', exactBonus, 0, 2, 0.05) }}
                {{ ui.slider('Prefix bonus', 'prefixBonus', prefixBonus, 0, 1, 0.05) }}
                {{ ui.slider('Popularity boost', 'boost', boost, 0, 0.2, 0.005) }}
                {{ ui.slider('Recency', 'recency', recency, 0, 1, 0.05) }}
                {{ ui.slider('Recency half-life (days)', 'halfLife', halfLife, 1, 365, 1) }}
            </div>
        </section>

        <section>
            <h2 class="list-title">Typos</h2>
            <div class="list">
                {{ ui.slider('Min relevance', 'minScore', minScore, 0, 1, 0.01) }}
                <label class="check setting"><input type="checkbox" data-model="similarityByLength" {{ similarityByLength ? 'checked' }}><span>Similarity by word length <small class="muted">The slider below then sets one value for every word.</small></span></label>
                {{ ui.slider('Fuzzy similarity', 'similarity', similarity, 0.05, 1, 0.05) }}
                <label class="setting select-row">Fuzzy mode
                    <select data-model="fuzzyMode">
                        {% for mode in ['fallback', 'always', 'never'] %}<option value="{{ mode }}" {{ mode == fuzzyMode ? 'selected' }}>{{ mode }}</option>{% endfor %}
                    </select>
                </label>
                {{ ui.slider('Fallback below (hits)', 'fallbackBelow', fallbackBelow, 1, 50, 1) }}
                {{ ui.slider('Candidate limit', 'candidateLimit', candidateLimit, 100, 10000, 100) }}
            </div>
        </section>

        <section>
            <h2 class="list-title">Filters</h2>
            <div class="list">
                <label class="check setting"><input type="checkbox" data-model="inStockOnly" {{ inStockOnly ? 'checked' }}><span>In stock only</span></label>
                {{ ui.slider('Max price (0 = any)', 'maxPrice', maxPrice, 0, 200000, 1000) }}
                {% if this.exactAllowed %}
                    <label class="check setting"><input type="checkbox" data-model="exactCounts" {{ exactCounts ? 'checked' }}><span>Exact counts <small class="muted">Count every match: the total and the facets, not only the candidates.</small></span></label>
                {% endif %}
            </div>
            {% if not this.exactAllowed %}
                <p class="muted caption">The total and the facets count the candidates (the candidate limit above). Exact counts read every match: start the stack with <code>DEMO_ALLOW_EXACT=1</code> to try them.</p>
            {% endif %}
        </section>
    </aside>

    <section class="pane">
        <div class="search-field">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <input type="search" data-model="debounce(250)|query" value="{{ query }}" aria-label="Search query" autocomplete="off" spellcheck="false" data-suggest-target="input" data-action="input->suggest#update" placeholder="Try typos, accents, -exclusions, &quot;phrases&quot;, brand:…">
            <span class="field-spinner" aria-hidden="true"></span>
        </div>
        <div class="suggest-panel" data-suggest-target="panel" data-live-ignore hidden></div>

        <div class="pane-bar">
            {# Results / SQL is pure client state: the radios are never re-rendered (data-live-ignore) and the panels below are
               shown or hidden with :has(), so a click is instant and exactly one radio is ever checked. #}
            <fieldset class="segmented" data-live-ignore>
                <legend class="sr-only">View</legend>
                <input type="radio" name="view" id="view-results" value="results" checked>
                <label for="view-results">Results</label>
                <input type="radio" name="view" id="view-sql" value="sql">
                <label for="view-sql">SQL / EXPLAIN</label>
            </fieldset>
        </div>

        <div class="panels busy-region">
            {% if this.error %}
                <p class="s-error" role="alert">{{ this.error }}</p>
            {% elseif this.result %}
                {% set result = this.result %}
                <div class="stat summary" aria-live="polite">
                    <span class="stat-value">{{ result.tookMs < 10 ? result.tookMs|number_format(1) : result.tookMs|number_format(0) }}</span><span class="stat-unit">ms</span>
                    <span class="stat-caption">
                        {{ result.total }}{{ result.totalIsLowerBound ? '+' }} hits{% if result.usedFuzzy %} · typo tolerant{% endif %}
                        {% if result.interpretedAs %}· understood as <code>{{ result.interpretedAs }}</code>{% endif %}
                    </span>
                </div>
                {% if result.warnings %}<div class="warnings">{% for warning in result.warnings %}<p>{{ warning }}</p>{% endfor %}</div>{% endif %}
                {% if result.didYouMean %}<p class="did-you-mean">Did you mean <code>{{ result.didYouMean }}</code>?</p>{% endif %}
                {# Facets: the values of a filter among the matches. A chosen category narrows the search; the facet still lists the other categories. #}
                {% set categories = this.categories %}
                {% set stock = result.facets.in_stock ?? [] %}
                {% if categories or stock %}
                    <div class="facets" aria-label="Facets">
                        {% for c in categories %}
                            <button type="button" class="chip" aria-pressed="{{ c.name == category ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="pickCategory" data-live-name-param="{{ c.name }}">{{ c.name }} <span class="muted">{{ c.count }}{{ result.totalIsLowerBound and not exactCounts ? '+' }}</span></button>
                        {% endfor %}
                        {% for s in stock %}
                            {% if s.value %}
                                <button type="button" class="chip" aria-pressed="{{ inStockOnly ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="toggleInStock">in stock <span class="muted">{{ s.count }}{{ result.totalIsLowerBound and not exactCounts ? '+' }}</span></button>
                            {% else %}
                                <span class="chip">out of stock <span class="muted">{{ s.count }}{{ result.totalIsLowerBound and not exactCounts ? '+' }}</span></span>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="panel panel-results">
                    {% set rows = this.rows %}
                    {% set top = (result.hits|first).score ?? 1 %}
                    <ol class="list" aria-label="Hits with their score breakdown">
                        {% for hit in result.hits %}
                            {% set b = hit.breakdown %}
                            {% set row = rows[hit.id] ?? null %}
                            {% set style = category_style(row.category ?? '') %}
                            <li class="row hit-row">
                                <span class="tile{{ style.hue < 0 ? ' is-neutral' }}" style="--h: {{ style.hue }}" aria-hidden="true"><svg class="icon"><use href="#{{ style.icon }}"/></svg></span>
                                <div class="row-body">
                                    {# the highlight is HTML-escaped by Fuzzphony (only <mark> is added); the fallback is raw database text, escaped by Twig #}
                                    <div class="row-title">{% if hit.highlights.name is defined %}{{ hit.highlights.name|raw }}{% else %}{{ row.name ?? hit.id }}{% endif %}</div>
                                    <div class="row-sub">{{ row.brand ?? '' }} · {{ row.category ?? '' }}{% if row %} · {{ row.price|number_format(0, '.', ' ') }} Ft{% endif %}</div>
                                    <div class="bar" role="img" aria-label="Score {{ hit.score|number_format(3) }}: text {{ (b.textRank * text)|number_format(3) }}, fuzzy {{ (b.fuzzySimilarity * fuzzy)|number_format(3) }}, bonus {{ (b.exactBonus + b.prefixBonus)|number_format(2) }}, boost {{ b.boostBonus|number_format(3) }}, recency {{ b.recencyBonus|number_format(3) }}" title="text {{ (b.textRank * text)|number_format(3) }} · fuzzy {{ (b.fuzzySimilarity * fuzzy)|number_format(3) }} · bonus {{ (b.exactBonus + b.prefixBonus)|number_format(2) }} · boost {{ b.boostBonus|number_format(3) }} · recency {{ b.recencyBonus|number_format(3) }}">
                                        <span class="b-text" style="width: {{ 100 * b.textRank * text / max(top, 0.001) }}%"></span>
                                        <span class="b-fuzzy" style="width: {{ 100 * b.fuzzySimilarity * fuzzy / max(top, 0.001) }}%"></span>
                                        <span class="b-bonus" style="width: {{ 100 * (b.exactBonus + b.prefixBonus) / max(top, 0.001) }}%"></span>
                                        <span class="b-boost" style="width: {{ 100 * b.boostBonus / max(top, 0.001) }}%"></span>
                                        <span class="b-recency" style="width: {{ 100 * b.recencyBonus / max(top, 0.001) }}%"></span>
                                    </div>
                                </div>
                                <div class="row-trailing">{{ hit.score|number_format(3) }}</div>
                            </li>
                        {% else %}
                            <li class="row no-lead"><span class="muted">No hits. Lower "Min relevance"{% if not similarityByLength %} or "Fuzzy similarity"{% endif %}, or switch fuzzy mode to "always".</span></li>
                        {% endfor %}
                    </ol>
                    <ul class="legend muted" aria-label="Bar colours">
                        <li><i class="b-text"></i>full-text</li><li><i class="b-fuzzy"></i>fuzzy</li><li><i class="b-bonus"></i>exact / prefix</li><li><i class="b-boost"></i>popularity</li><li><i class="b-recency"></i>recency</li>
                    </ul>
                </div>

                <div class="panel panel-sql">
                    {% if this.analyzeAllowed %}
                        <label class="check"><input type="checkbox" data-model="analyze" {{ analyze ? 'checked' }}> EXPLAIN ANALYZE (runs the query again to time each plan node)</label>
                    {% else %}
                        <p class="muted">EXPLAIN ANALYZE (timing each plan node) is off in this demo: it runs every query a second time. Start the stack with <code>DEMO_ALLOW_ANALYZE=1</code> to enable it.</p>
                    {% endif %}
                    {% if this.explanation %}
                        {% for statement in this.explanation.statements %}
                            <h3>{{ statement.label }}</h3>
                            <pre>{{ statement.sql }}</pre>
                            <pre>params: {{ statement.params|json_encode }}</pre>
                        {% endfor %}
                        <h3>Plan</h3>
                        <pre>{{ this.explanation.plan|join("\n") }}</pre>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>
</div>
