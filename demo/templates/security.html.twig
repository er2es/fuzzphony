{% extends 'base.html.twig' %}
{% block title %}{{ q != '' ? q ~ ' · ' }}Security · Fuzzphony{% endblock %}

{% block body %}
<div class="page stack">
    <div class="hero">
        <p class="crumb">Under the hood</p>
        <h1>Security</h1>
        <p class="lede">Who is searching decides what a search may see. Switch the viewer and search the same words.</p>

        <nav class="segmented" aria-label="Viewing as">
            {% for id, name in viewers %}
                <a href="{{ path('security', {as: id, q: q ?: null}) }}"{% if id == viewerId %} aria-current="true"{% endif %} data-loading-message="Viewing as {{ name }}…">{{ name }}</a>
            {% endfor %}
        </nav>

        <form method="get" action="{{ path('security') }}" role="search" class="field-wrap">
            <input type="hidden" name="as" value="{{ viewerId }}">
            <div class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <input type="search" name="q" value="{{ q }}" placeholder="Try salary, budget or lawsuit" aria-label="Search the intranet notes" autocomplete="off" spellcheck="false" enterkeyhint="search" maxlength="100">
            </div>
            <button type="submit" class="sr-only">Search</button>
        </form>
        <div class="chips chips-center">
            {% for label, example in examples %}
                <a class="chip" href="{{ path('security', {as: viewerId, q: example}) }}" data-loading-message="Searching for {{ example }}…"><code>{{ example }}</code> <small>{{ label }}</small></a>
            {% endfor %}
        </div>
    </div>

    {% if wasReset %}<p class="callout" role="status">The count is back to zero: {{ viewer.name }} can search five times again (a shortcut for the demo).</p>{% endif %}

    {% if outcome %}
        <section aria-labelledby="outcome">
            <h2 id="outcome" class="sr-only">The answer</h2>
            {% if outcome.kind == 'limited' %}
                {# The wait counts down in the browser (countdown_controller.js); the ticking number is hidden from screen readers, the card
                   announces the wait once and the end of it once. Without JavaScript the number stays as the server rendered it. #}
                <div class="callout is-warn" role="alert" data-controller="countdown" data-countdown-seconds-value="{{ outcome.retryAfter }}">
                    <div class="callout-body">
                        <strong data-countdown-target="title">Too many searches: try again in <span class="sr-only">{{ outcome.retryAfter }} seconds</span><span aria-hidden="true" data-countdown-target="seconds">{{ outcome.retryAfter }} s</span>.</strong>
                        <span class="muted">{{ viewer.name }} may search {{ limit }} times in 10 seconds (<code>fuzzphony.rate_limit</code>, per user). In an application this is an HTTP 429 with a <code>Retry-After</code> header; here it is <code>{{ outcome.class }}</code> caught by the page. Resetting the count is a shortcut for the demo.</span>
                    </div>
                    <a class="button primary small" data-countdown-target="reset" href="{{ path('security', {as: viewerId, q: q, reset: 1}) }}">Reset the count</a>
                    <a class="button primary small" data-countdown-target="again" href="{{ path('security', {as: viewerId, q: q}) }}" hidden>Search again</a>
                    <p class="sr-only" role="status" data-countdown-target="done"></p>
                </div>
            {% elseif outcome.kind == 'actor' %}
                <div class="callout is-bad" role="alert">
                    <div class="callout-body">
                    <strong>Refused: an anonymous visitor cannot search the <code>intranet</code> index.</strong>
                    <span class="muted">The index is tenant-scoped and nobody is signed in, so there is no company to search in (<code>{{ outcome.class }}</code>; an application answers 403). The tenant check comes before the authorization: an anonymous visitor has no tenant, so the search is refused before anyone asks whether searching is granted (switch to Eve to see that refusal). Choose a viewer above.</span>
                    </div>
                </div>
            {% elseif outcome.kind == 'denied' %}
                <div class="callout is-bad" role="alert">
                    <div class="callout-body">
                    <strong>Searching <code>intranet</code> is not granted to this actor: {{ viewer.name }} has no <code>ROLE_USER</code>.</strong>
                    <span class="muted"><code>{{ outcome.class }}</code>: {{ outcome.message }} {{ viewer.name }} is signed in and has a company, so the tenant is not the problem: <code>SearchVoter</code> denies <code>FUZZPHONY_SEARCH</code> without <code>ROLE_USER</code>. In an application this is an HTTP 403. A refused search spends no token: the rate limit comes after the authorization.</span>
                    </div>
                </div>
            {% else %}
                <div class="callout is-bad" role="alert">
                    <div class="callout-body">
                    <strong>That search could not run.</strong>
                    <span class="muted"><code>{{ outcome.class }}</code>: {{ outcome.message }}</span>
                    </div>
                </div>
            {% endif %}
        </section>
    {% elseif result %}
        <section aria-labelledby="found">
            <h2 id="found" class="list-title">{{ result.total }} {{ result.total == 1 ? 'note' : 'notes' }} for {{ viewer.name }} in {{ viewer.companyName }}</h2>
            {% if result.hits is empty %}
                <p class="muted" role="status">Nothing found.{% if forbidden %} A word that occurs only in a field this viewer may not search ({% for f, role in forbidden %}<code>{{ f }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}) is not matched: it cannot find a note.{% endif %}</p>
            {% else %}
                <ul class="list">
                    {% for hit in result.hits %}
                        {% set row = rows[hit.id] ?? null %}
                        <li class="row hit-row no-lead">
                            <div class="row-body">
                                <div class="row-title">{% if hit.highlights.title is defined %}{{ hit.highlights.title|raw }}{% else %}{{ row.title ?? hit.id }}{% endif %}</div>
                                {% if row %}
                                    <div class="row-sub">{% if hit.highlights.body is defined %}{{ hit.highlights.body|raw }}{% else %}{{ row.body|length > 110 ? row.body|slice(0, 110) ~ '…' : row.body }}{% endif %}</div>
                                {% endif %}
                                {% if hit.highlights.confidential is defined %}
                                    <div class="row-sub"><strong>Confidential (HR only):</strong> {{ hit.highlights.confidential|raw }}</div>
                                {% endif %}
                            </div>
                            {% if row %}<span class="flag">{{ companies[row.company_id] ?? row.company_id }}</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}

    <section aria-labelledby="facts">
        <h2 id="facts" class="list-title">What this viewer may do</h2>
        <ul class="list">
            <li class="row no-lead">
                <div class="row-body">
                    <div class="row-title">Viewing as</div>
                    <div class="row-sub">{% if viewer %}{{ viewer.name }}, {{ viewer.roles ? 'signed in with ' ~ viewer.roles|join(', ') : 'signed in, but without any role' }}{% else %}an anonymous visitor: nobody is signed in, so no role and no company{% endif %}</div>
                </div>
            </li>
            <li class="row no-lead">
                <div class="row-body">
                    <div class="row-title">Company (the tenant)</div>
                    <div class="row-sub">{% if viewer %}{{ viewer.companyName }} (<code>company_id = {{ viewer.company }}</code>): {% if allowed %}a search sees this company's notes and no other's{% else %}the tenant check passes, but searching is not granted{% endif %}{% else %}none: a tenant-scoped index refuses a search without one{% endif %}</div>
                </div>
            </li>
            <li class="row no-lead">
                <div class="row-body">
                    <div class="row-title">Fields searched</div>
                    <div class="row-sub">
                        {% if allowed %}
                            {% for f in allowed %}<code>{{ f }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}
                            {% for f, role in forbidden %}<br>not <code>{{ f }}</code>: it needs <code>{{ role }}</code>{% endfor %}
                        {% else %}
                            none: searching <code>intranet</code> needs <code>ROLE_USER</code>
                        {% endif %}
                    </div>
                </div>
            </li>
            <li class="row no-lead">
                <div class="row-body">
                    <div class="row-title">Rate limit</div>
                    <div class="row-sub">
                        {% if viewer %}
                            {{ used }} of {{ limit }} searches used in the current 10 seconds (per user); each search on this page spends one, its SQL included
                        {% else %}
                            not counted: the limit is per user, and an anonymous visitor is refused before it
                        {% endif %}
                    </div>
                </div>
                {% if viewer %}<a class="button small" href="{{ path('security', {as: viewerId, q: q ?: null, reset: 1}) }}">Reset the count</a>{% endif %}
            </li>
        </ul>
    </section>

    {% if explanation %}
        <details class="disclosure">
            <summary>The SQL of this search<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></summary>
            <p class="muted">This is what <code>explain()</code> returned for {{ viewer.name }}: the statements Fuzzphony ran for the search above. {% if forbidden %}It reads only the columns of the fields this viewer may search ({% for f in allowed %}<code>t_{{ f }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}): the hidden field is not in it, so it is not matched, not ranked and not highlighted.{% else %}This viewer may search every field, so the SQL is the one of an unrestricted search: it reads the combined <code>tsv</code> column of all of them.{% endif %}</p>
            <p class="muted">Understood as <code>{{ explanation.interpretedAs }}</code></p>
            {% for s in explanation.statements %}
                <h3 class="list-title">{{ s.label }}</h3>
                <pre><code>{{ s.sql }}</code></pre>
                {% if s.params %}<p class="muted">Parameters: {% for name, value in s.params %}<code>:{{ name }} = {{ value is null ? 'NULL' : value }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}</p>{% endif %}
            {% endfor %}
            {% if explanation.plan %}<h3 class="list-title">Plan</h3><pre><code>{{ explanation.plan|join("\n") }}</code></pre>{% endif %}
        </details>
    {% endif %}

    <p class="muted">The viewers are five fixed accounts without passwords: the choice is kept in the session, and nothing about a viewer comes from the request. The search is made with <code>-&gt;asActor()</code>; the other pages of the demo never do, so nothing here applies to them. The guards run from <code>fuzzphony.actor</code>, <code>fuzzphony.authorization</code> and <code>fuzzphony.rate_limit</code> in <code>config/packages/fuzzphony.yaml</code>, and the field's <code>granted: ROLE_HR</code> is on the <code>intranet</code> index. This page is the worked example of <code>docs/security.md</code>.</p>
</div>
{% endblock %}
