{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ q != '' ? q ~ ' · ' }}{{ language.name }} · Languages · Fuzzphony{% endblock %}

{# `word` in a caption becomes <code>word</code>; everything else is escaped. #}
{% macro caption(text) %}{% for part in text|split('`') %}{% if loop.index is even %}<code>{{ part }}</code>{% else %}{{ part }}{% endif %}{% endfor %}{% endmacro %}

{% block body %}
{% set total = products|length %}
<div class="page stack">
    <div class="hero">
        <h1>Languages</h1>
        <p class="lede">One small catalogue in five languages. Each has its own index, so each stems, folds accents and drops stop words by its own rules.</p>

        <nav class="chips chips-center" aria-label="Language">
            {% for c, l in languages %}
                <a class="chip{{ c == code ? ' is-current' }}" href="{{ path('languages', {lang: c, q: q ?: null}) }}"{% if c == code %} aria-current="page"{% endif %} lang="{{ c }}" data-loading-message="Switching the language…">{{ l.native }}{% if l.native != l.name %} <small>{{ l.name }}</small>{% endif %}</a>
            {% endfor %}
        </nav>

        {{ ui.search_field(path('languages'), q, language.index, 'Search the ' ~ language.name ~ ' catalogue', {lang: code}) }}
    </div>

    {% if q == '' %}
        <section aria-labelledby="try">
            <h2 id="try" class="list-title">Try, in {{ language.name }}</h2>
            <ul class="list">
                {% for preset in language.presets %}
                    <li class="row no-lead">
                        <a class="row-body preset-link" href="{{ path('languages', {lang: code, q: preset.q}) }}" data-loading-message="Searching for {{ preset.q }}…">
                            <span class="row-title" lang="{{ code }}">{{ preset.q }}</span>
                            <span class="row-sub">{{ _self.caption(preset.caption) }}</span>
                        </a>
                        <span class="flag{{ preset.kind ends with 'not matched' ? ' is-limit' }}">{{ preset.kind }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        {% set found = result ? result.total : 0 %}
        {% set scale = max(found, ilike|length, 1) %}
        <section aria-labelledby="contrast" class="speed-bars">
            <h2 id="contrast" class="sr-only">ILIKE compared with Fuzzphony</h2>
            <div class="speed-row">
                <span>ILIKE</span>
                <span class="speed-bar"><span style="width: {{ max(1, (ilike|length / scale * 100)|round) }}%"></span></span>
                <span class="speed-value">{{ ilike|length }}</span>
            </div>
            <div class="speed-row">
                <span>Fuzzphony</span>
                <span class="speed-bar"><span class="is-fuzzphony" style="width: {{ max(1, (found / scale * 100)|round) }}%"></span></span>
                <span class="speed-value">{{ found }}</span>
            </div>
            <p class="muted">of {{ total }} {{ language.name }} products. ILIKE looks for the exact letters; Fuzzphony matches word stems, ignores accents and stop words and tolerates typos.</p>
        </section>

        <div class="results-layout wide-side">
            <section aria-labelledby="hits">
                <h2 id="hits" class="list-title">Found by Fuzzphony</h2>
                {% if error %}
                    <p class="callout is-bad" role="alert">{{ error }}</p>
                {% elseif result %}
                    {% if result.warnings %}<div class="warnings">{% for warning in result.warnings %}<p>{{ warning }}</p>{% endfor %}</div>{% endif %}
                    <ul class="list">
                        {% for hit in result.hits %}
                            {% set row = products[hit.id] ?? null %}
                            {% set style = category_style(row.category ?? '') %}
                            <li class="row">
                                <span class="tile{{ style.hue < 0 ? ' is-neutral' }}" style="--h: {{ style.hue }}" aria-hidden="true"><svg class="icon"><use href="#{{ style.icon }}"/></svg></span>
                                <div class="row-body">
                                    {# names[hit.id]: the library's highlight (escaped HTML with <mark>), completed by the controller #}
                                    <div class="row-title" lang="{{ code }}">{% if names[hit.id] ?? null %}{{ names[hit.id]|raw }}{% else %}{{ row.name ?? hit.id }}{% endif %}</div>
                                    <div class="row-sub" lang="{{ code }}">{% if hit.highlights.description is defined %}{{ hit.highlights.description|raw }}{% else %}{{ row.description ?? '' }}{% endif %}</div>
                                </div>
                                <div class="row-flags">
                                    {% if hit.breakdown.textRank == 0 and hit.breakdown.fuzzySimilarity > 0 %}<span class="flag">typo match</span>{% endif %}
                                    {% if hit.id not in ilike %}<span class="flag is-limit">ILIKE misses this</span>{% endif %}
                                </div>
                            </li>
                        {% else %}
                            <li class="row no-lead"><span class="muted">Nothing found{% if language.presets|filter(p => p.q == q and p.kind ends with 'not matched')|length %}, as expected: the stemmer has no rule that turns this word into the one in the catalogue{% endif %}.</span></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <aside aria-labelledby="analysis">
                <h2 id="analysis" class="list-title">How the words were analysed</h2>
                {% if analysis is empty %}
                    <p class="muted">No words to analyse: only punctuation or numbers PostgreSQL does not treat as words.</p>
                {% else %}
                    <ul class="list">
                        {% for w in analysis %}
                            {% set stop = w.lexeme is null %}
                            {% set folded = w.folded != w.token %}
                            <li class="row no-lead word{{ stop ? ' is-stop' }}">
                                <div class="row-body">
                                    <div class="word-line">
                                        <span class="word-token" lang="{{ code }}">{{ w.token }}</span>
                                        {% if stop %}
                                            <span class="flag">stop word</span>
                                        {% else %}
                                            <svg class="icon arrow" aria-hidden="true"><use href="#i-chevron"/></svg><code class="lexeme">{{ w.lexeme }}</code>
                                        {% endif %}
                                    </div>
                                    <div class="row-sub">
                                        {% if stop %}
                                            A filler word: it neither has to match nor counts.
                                        {% else %}
                                            {% if folded %}Accents removed first. {% endif %}{{ w.lexeme == w.folded|lower ? 'The stem is unchanged.' : 'Cut to its stem.' }}
                                            {% if w.docs > 0 %}In {{ w.docs }} product{{ w.docs == 1 ? '' : 's' }} exactly.{% else %}In no product exactly{% if result and result.usedFuzzy %}{{ result.total > 0 ? ': only typo tolerance can find it' : ', and typo tolerance found nothing close either' }}{% elseif result and result.total > 0 %}: products are found through its synonyms (or the other words){% endif %}.{% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if result %}<p class="muted caption">Fuzzphony understood <code>{{ result.interpretedAs }}</code>{% if result.usedFuzzy %} and used typo tolerance{% endif %}. Text search configuration: <code>{{ language.config }}</code>.</p>{% endif %}
            </aside>
        </div>

        {# Federated search: the same text over every language's index, one merged list. Scores of different indexes cannot be
           compared, so the lists are merged by rank (reciprocal rank fusion): the best hit of each language first. #}
        {% if federated %}
            <section aria-labelledby="all">
                <h2 id="all" class="list-title">All five languages at once</h2>
                <ul class="list">
                    {% for h in federated.hits %}
                        <li class="row no-lead">
                            <span class="flag lang-flag">{{ h.index|replace({'lang_': ''}) }}</span>
                            <div class="row-body"><div class="row-title" lang="{{ h.index|replace({'lang_': ''}) }}">{{ federatedNames[h.index][h.hit.id] ?? h.hit.id }}</div></div>
                            <div class="row-trailing muted" title="Rank in the merged list">#{{ loop.index }}</div>
                        </li>
                    {% else %}
                        <li class="row no-lead"><span class="muted">Nothing found in any language.</span></li>
                    {% endfor %}
                </ul>
                <p class="muted caption">
                    {% for index, r in federated.results %}{{ index|replace({'lang_': ''}) }} {{ r.total }}{{ loop.last ? '' : ' · ' }}{% endfor %}
                    · {{ federated.total }} hits in all · merged by rank, {{ federated.tookMs|number_format(1) }} ms
                </p>
            </section>
        {% endif %}
    {% endif %}

    <details class="disclosure">
        <summary>All {{ total }} {{ language.name }} products<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></summary>
        <ul class="columns" lang="{{ code }}">
            {% for p in products %}<li>{{ p.name }} <span class="muted">{{ p.category }}</span></li>{% endfor %}
        </ul>
    </details>
</div>
{% endblock %}
