<tr>
    <td>{{ r.label }}<br><code class="muted">{{ r.q }}</code></td>
    <td class="num">{{ r.without.cold|number_format(1) }} ms</td>
    <td class="num">{{ r.without.warm|number_format(1) }} ms</td>
    <td class="num {{ r.without.value|length == 0 ? 's-error' }}">{{ r.without.value|length }}</td>
    <td class="num">{{ r.with.cold|number_format(1) }} ms</td>
    <td class="num">{{ r.with.warm|number_format(1) }} ms</td>
    <td class="num">{{ r.with.value.hits|length }}{{ r.with.value.usedFuzzy ? ' ~' }}</td>
</tr>
