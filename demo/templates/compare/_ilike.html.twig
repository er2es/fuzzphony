<h2>With ILIKE <code>'%…%'</code></h2>
{% if without %}
    <p class="muted">{{ without.value|length }} hits · warm median {{ without.warm|number_format(1) }} ms · cold {{ without.cold|number_format(1) }} ms · no ranking</p>
    <ul class="hits">
        {% for row in without.value %}
            <li>{{ row.name }} <span class="muted">· {{ row.brand }}</span></li>
        {% else %}
            <li class="muted">Nothing found. The text has to match the stored spelling exactly.</li>
        {% endfor %}
    </ul>
{% else %}
    <p class="muted">Type something to search.</p>
{% endif %}
