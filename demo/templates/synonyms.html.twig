{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}Synonyms · Fuzzphony{% endblock %}

{% block body %}
<div class="page stack">
    <div class="hero">
        <p class="crumb"><a href="{{ path('relevance') }}">Relevance</a></p>
        <h1>Synonyms</h1>
        <p class="lede">Words that mean the same, one list per index and so per language. A saved list is used by the next search: no reindex.</p>
    </div>

    <nav class="chips chips-center" aria-label="Index">
        {% for name, label in indexes %}
            <a class="chip{{ name == index ? ' is-current' }}" href="{{ path('synonyms', {index: name}) }}"{% if name == index %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>

    <section aria-labelledby="list">
        <h2 id="list" class="list-title">{{ indexes[index] }} · <code>{{ index }}</code></h2>
        {% if saved %}<p class="callout is-ok" role="status"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Saved. The next search uses the new list.</p>{% endif %}
        {% if problems %}
            <div class="callout is-bad" role="alert">
                <strong>Not saved</strong>
                <ul>{% for p in problems %}<li>{{ p }}</li>{% endfor %}</ul>
            </div>
        {% endif %}
        <form method="post" action="{{ path('synonyms', {index: index, q: q}) }}" class="editor" data-loading-message="Saving…">
            <textarea name="body" rows="10" spellcheck="false" aria-label="Synonyms of {{ indexes[index] }}">{{ text }}</textarea>
            <div class="editor-bar">
                <span class="muted">One entry per line. <code>tv, television</code> is a group, <code>drill =&gt; screwdriver</code> a one-way rule, <code>#</code> a comment.</span>
                <button type="submit" class="primary">Save</button>
            </div>
        </form>
    </section>

    <details class="disclosure">
        <summary>Group or rule?<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></summary>
        <div class="stack">
            <p><strong>A group</strong> (<code>tv, television, telly</code>) is mutual: any of them finds the others. Use it for words that really mean the same.</p>
            <p><strong>A rule</strong> (<code>drill =&gt; screwdriver</code>) goes one way: a search for <code>drill</code> also finds screwdrivers, but a search for <code>screwdriver</code> does not find drills. Use it when the left word is the narrower one and you want to offer the broader or related things on the right (<code>laptop =&gt; notebook, portable</code>).</p>
            <p>Words are compared by their stem in the index's language, with accents folded: <code>televisions</code> finds the group of <code>television</code>. English keeps a plural abbreviation such as <code>tvs</code> as it is, so list it as a member.</p>
        </div>
    </details>

    <section aria-labelledby="try" class="stack">
        <h2 id="try">Try it</h2>
        {{ ui.search_field(path('synonyms'), q, index, 'Search ' ~ indexes[index], {index: index}) }}
        <div class="chips">
            {% for example in examples %}<a class="chip" href="{{ path('synonyms', {index: index, q: example}) }}"><code>{{ example }}</code></a>{% endfor %}
        </div>
        {% if error %}<p class="callout is-bad" role="alert">{{ error }}</p>{% endif %}
        {% if result %}
            <p class="muted">{{ result.total }}{{ result.totalIsLowerBound ? '+' }} hits · understood as <code>{{ result.interpretedAs }}</code></p>
            <ul class="list">
                {% for hit in result.hits %}
                    <li class="row no-lead"><div class="row-body"><div class="row-title">{{ names[hit.id] ?? hit.id }}</div></div></li>
                {% else %}
                    <li class="row no-lead"><span class="muted">Nothing found.</span></li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
