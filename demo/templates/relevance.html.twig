{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ q != '' ? q ~ ' · ' }}Relevance · Fuzzphony{% endblock %}

{% block body %}
<div class="page stack">
    <div class="hero">
        <h1>Relevance</h1>
        <p class="lede">Why a search finds what was meant: how far a typo may stray, which words mean the same, and what to suggest.</p>
        {{ ui.search_field(path('relevance'), q, 'catalog', 'Try mose, tv or hedphones') }}
    </div>

    <div class="example-groups">
        {% for group, items in examples %}
            <div>
                <h2 class="list-title">{{ group }}</h2>
                {{ ui.examples(items, 'relevance') }}
            </div>
        {% endfor %}
    </div>

    {% if byLength %}
        <section aria-labelledby="typos" class="stack">
            <div>
                <h2 id="typos">Typos</h2>
                <p class="muted">A word needs the similarity of the worst typo its length allows: one from four letters, two from eight. <code>mouse</code> is not <code>monitor</code>. A flat 0.3, the rule before 0.7, is on the right.</p>
            </div>
            <div class="two-up">
                <div>
                    <h3 class="list-title">By word length (the default)</h3>
                    <ul class="list">
                        {% for hit in byLength.hits %}{{ ui.hit_row(hit, rows[hit.id] ?? null, hit.id in onlyByLength ? 'only here') }}{% else %}<li class="row no-lead"><span class="muted">Nothing found.</span></li>{% endfor %}
                    </ul>
                    <p class="muted caption">{{ byLength.total }}{{ byLength.totalIsLowerBound ? '+' }} hits · <code>{{ byLength.interpretedAs }}</code></p>
                </div>
                <div>
                    <h3 class="list-title">Flat 0.3</h3>
                    <ul class="list">
                        {% for hit in flat.hits %}{{ ui.hit_row(hit, rows[hit.id] ?? null, hit.id in onlyFlat ? 'only here') }}{% else %}<li class="row no-lead"><span class="muted">Nothing found.</span></li>{% endfor %}
                    </ul>
                    <p class="muted caption">{{ flat.total }}{{ flat.totalIsLowerBound ? '+' }} hits · <code>{{ flat.interpretedAs }}</code></p>
                </div>
            </div>
        </section>

        <section aria-labelledby="syn">
            <h2 id="syn">Synonyms</h2>
            <ul class="list">
                <li class="row no-lead">
                    <div class="row-body">
                        <div class="row-title">Understood as <code>{{ suggestion.interpretedAs }}</code></div>
                        <div class="row-sub">{% if suggestion.interpretedAs == q|lower or suggestion.interpretedAs == q %}No synonym applies to this query.{% else %}The catalogue's synonyms were expanded on the query, no reindex needed.{% endif %}</div>
                    </div>
                    <a class="button" href="{{ path('synonyms', {index: 'catalog'}) }}">Edit synonyms</a>
                </li>
            </ul>
        </section>

        <section aria-labelledby="dym">
            <h2 id="dym">Did you mean</h2>
            <ul class="list">
                <li class="row no-lead">
                    <div class="row-body">
                        {% if suggestion.didYouMean %}
                            <div class="row-title"><a href="{{ path('relevance', {q: suggestion.didYouMean}) }}" data-loading-message="Searching for {{ suggestion.didYouMean }}…">{{ suggestion.didYouMean }}</a></div>
                            <div class="row-sub">A word the index has never seen was replaced by its nearest word.</div>
                        {% else %}
                            <div class="row-title">No suggestion</div>
                            <div class="row-sub">Every word is known to the index, or the search found enough.</div>
                        {% endif %}
                    </div>
                </li>
            </ul>
        </section>
    {% endif %}
</div>
{% endblock %}
