{% extends 'base.html.twig' %}
{% block title %}Relevance · Fuzzphony{% endblock %}

{% macro hits(result, rows) %}
    <p class="muted">
        {{ result.total }}{{ result.totalIsLowerBound ? '+' }} hits{% if result.usedFuzzy %} · typo tolerant{% endif %}
        · understood as <code>{{ result.interpretedAs }}</code>
    </p>
    <ul class="hits">
        {% for hit in result.hits %}
            {% set row = rows[hit.id] ?? null %}
            <li>
                {% if hit.highlights.name is defined %}{{ hit.highlights.name|raw }}{% else %}{{ row.name ?? hit.id }}{% endif %}
                <span class="muted">· {{ row.brand ?? '' }}</span>
            </li>
        {% else %}
            <li class="muted">Nothing found.</li>
        {% endfor %}
    </ul>
{% endmacro %}
{% import _self as ui %}

{% block body %}
    <form method="get" class="searchbar" data-loading-message="Searching…">
        <input type="search" name="q" value="{{ q }}" aria-label="Search the catalogue" placeholder="Search the catalogue…" autofocus>
        <button type="submit" class="primary">Search</button>
    </form>
    <p class="muted">
        Three things that decide whether a search finds what was meant: how similar a word has to be to count as a typo
        (it depends on the word's length), the synonyms the catalogue knows, and the suggestion for a word the index has never seen.
        Pick an example, or type your own.
    </p>
    {% for group, items in examples %}
        <h2>{{ group }}</h2>
        <div class="examples">
            {% for label, example in items %}
                <a class="button" href="{{ path('relevance', {q: example}) }}" data-loading-message="Searching for {{ example }}…">{{ label }}: <code>{{ example }}</code></a>
            {% endfor %}
        </div>
    {% endfor %}

    {% if byLength %}
        <h2>Typo tolerance</h2>
        <p class="muted">
            Both columns search with typo tolerance on (<code>fuzzy_mode: always</code>), so only the similarity rule differs. By word length a word
            needs the similarity of the worst typo its length allows (one typo from 4 letters, two from 8): <code>mouse</code> is not <code>monitor</code>.
            A flat <code>fuzzy_similarity: 0.3</code> is what 0.6 did.
        </p>
        <div class="grid">
            <section class="card">
                <h2>By word length (default)</h2>
                {{ ui.hits(byLength, rows) }}
            </section>
            <section class="card">
                <h2>Flat 0.3 (0.6 behaviour)</h2>
                {{ ui.hits(flat, rows) }}
            </section>
        </div>

        <h2>Synonyms and the suggestion</h2>
        <section class="card">
            <p>
                The catalogue's synonyms (<code>config/packages/fuzzphony.yaml</code>) are expanded on the query:
                <code>{{ suggestion.interpretedAs }}</code>
                {% if suggestion.interpretedAs == q|lower or suggestion.interpretedAs == q %}<span class="muted">(no synonym applies to this query)</span>{% endif %}
            </p>
            {% if suggestion.didYouMean %}
                <p>Did you mean <a href="{{ path('relevance', {q: suggestion.didYouMean}) }}" data-loading-message="Searching for {{ suggestion.didYouMean }}…"><strong>{{ suggestion.didYouMean }}</strong></a>?</p>
            {% else %}
                <p class="muted">No suggestion: every word is known to the index, or the search found enough hits.</p>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
