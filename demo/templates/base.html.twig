<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Fuzzphony demo{% endblock %}</title>
    {# An inline icon: without one the browser asks for /favicon.ico on every page load, and that 404 boots the whole kernel. #}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8E%BC%3C/text%3E%3C/svg%3E">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body data-controller="progress">
<a class="skip-link" href="#main">Skip to content</a>
<div class="topbar" aria-hidden="true"><span></span></div>
<div class="nav-status" role="status" aria-live="polite"><span class="spinner" aria-hidden="true"></span><span data-progress-target="message"></span></div>
<header>
    <strong>🎼 Fuzzphony</strong>
    <nav aria-label="Demo pages">
        {% set route = app.request.attributes.get('_route') %}
        {% set pages = {
            compare: ['ILIKE vs Fuzzphony', 'Running ILIKE and Fuzzphony side by side…'],
            playground: ['Playground', 'Opening the playground…'],
            languages: ['Languages', 'Opening the languages page…'],
            wizard: ['Config wizard', 'Introspecting the database…'],
            benchmark: ['Benchmark', 'Opening the benchmark…'],
            doctor: ['Doctor', 'Running the health checks…'],
        } %}
        {% for name, page in pages %}
            <a href="{{ path(name) }}" data-loading-message="{{ page[1] }}"{% if route == name %} class="active" aria-current="page"{% endif %}>{{ page[0] }}</a>
        {% endfor %}
    </nav>
</header>
<main id="main" tabindex="-1">{% block body %}{% endblock %}</main>
</body>
</html>
