# Settings for the Docker stack (docker-compose.yml). Copy to docker.env (git-ignored) and start with
#   docker compose --env-file docker.env up --build
# Plain environment variables work as well. Every value below is the default, so this file is optional.
# (demo/.env belongs to Symfony and is not used by the containers.)

# Host ports. DEMO_BIND is the address the web port is published on (empty = every interface, as before;
# 127.0.0.1 keeps the demo private to this machine). The database port is published on 127.0.0.1 only by default
# (connect to 127.0.0.1, not "localhost": on Windows localhost tries ::1 first and every connection waits ~200 ms).
DEMO_PORT=8000
DEMO_DB_PORT=5432
DEMO_BIND=
DEMO_DB_BIND=127.0.0.1

# Size of the catalogue created on the first start (1000000 = the full benchmark catalogue, a few minutes).
DEMO_ROWS=200000
# Reindex on start: auto (only when the index is empty or was just seeded), always, never.
DEMO_REINDEX=auto

# Secrets. Throwaway values for a local demo: change both before exposing the stack to anyone else.
# The password is embedded in a URL, so keep it to letters, digits, "-" and "_".
DEMO_APP_SECRET=demo-only-not-a-secret-change-me
DEMO_DB_PASSWORD=fuzzphony

# php-fpm pool (dynamic). See README.md "Tuning".
PHP_FPM_MAX_CHILDREN=16
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE_SERVERS=2
PHP_FPM_MAX_SPARE_SERVERS=6
PHP_FPM_MAX_REQUESTS=500
PHP_FPM_SLOWLOG_TIMEOUT=3s

# docker-compose.dev.yml only: the user the containers run as (files written to the bind mount).
DEMO_UID=1000
DEMO_GID=1000
